{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "module": "ESNext", "moduleResolution": "Bundler",
    "isolatedModules": true, "jsx": "react-jsx"
  },
  "include": ["src"]
}
